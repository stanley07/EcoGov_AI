# Server configuration
PORT=8080
WORKER_PORT=8081
APP_ENV=local

# Database settings
DATABASE_URL=postgres://postgres:postgres@localhost:5432/govos_db

# AI Provider configurations (Options: deterministic, gemini-api, vertex-ai)
AI_PROVIDER=deterministic
GEMINI_MODEL_ID=gemini-1.5-flash

# Required only if AI_PROVIDER=gemini-api
GEMINI_API_KEY=

# Required only if AI_PROVIDER=vertex-ai
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Worker security config (Options: local, oidc)
WORKER_AUTH_MODE=local
WORKER_OIDC_AUDIENCE=https://worker-url-placeholder

# Observability settings
LOG_LEVEL=info

# PAY-1 registration payments. Never commit real keys.
PAYMENT_PROVIDER=paystack
PAYSTACK_ENVIRONMENT=test
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3001/#/marketplace/status

# Explicit local/test-only compatibility controls. Never enable in staging/production.
PAYMENTS_DEMO_ENABLED=false
PAYMENTS_DEMO_TOKEN=
WEBHOOK_SECRET=
